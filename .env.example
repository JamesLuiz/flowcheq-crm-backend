# Flowcheq CRM backend — Coolify Environment tab (or cp .env.example .env)

PORT=3000
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/messaging

TELNYX_API_KEY=
