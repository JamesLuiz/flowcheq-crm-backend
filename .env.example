# Copy to .env and fill secrets (never commit .env)

PORT=3000
APP_URL=https://api.flowcheq.com
FRONTEND_URL=http://localhost:5173/
CORS_ORIGINS=http://localhost:5173,https://messaging.flowcheq.com

MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/flowcheq_lead?appName=flowcheq

JWT_SECRET=
JWT_EXPIRES_IN=7d
CONSULTATION_URL=https://flowcheq.com/consultation
LINK_TRACKING_BASE_URL=https://flowcheq.com
N8N_BUSINESS_ENRICH_WEBHOOK=https://n8n.flowcheq.com/webhook/flowcheq/business-enrich
FLOWCHEQ_WEBHOOK_SECRET=
WEBHOOK_SECRET=

# Default outbound SMS service: telnyx | twilio (frontend can switch per send)
SMS_PROVIDER=telnyx

# Twilio (optional second SMS provider) — Console → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional: Messaging Service SID (used instead of TWILIO_PHONE_NUMBER when set)
TWILIO_MESSAGING_SERVICE_SID=
# Twilio number → Messaging → "A message comes in" webhook: {APP_URL}/webhook/inbound (HTTP POST)

TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=
# Telnyx profile webhook URL: {TELNYX_WEBHOOK_BASE_URL}/webhook/inbound
# US SMS requires 10DLC brand + campaign registration; assign number to campaign in Telnyx portal.
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_WEBHOOK_BASE_URL=https://api.flowcheq.com
TELNYX_CONNECTION_ID=
TELNYX_WEBRTC_CONNECTION_ID=
N8N_CALL_ROUTER_WEBHOOK=

# Inbound calls: your mobile in E.164 (e.g. +16175551234). Used by /webhook/telnyx/voice.
# Rings HUMAN_FORWARD_NUMBER and the messaging app (WebRTC) at the same time; first answer wins.
# Telnyx Portal → Voice → Call Control App → Webhook URL = {APP_URL}/webhook/telnyx/voice
HUMAN_FORWARD_NUMBER=+2348146609734
